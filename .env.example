# PromptKeeper 2.0 - Optional Supabase Cloud Synchronization & Auth
# Copy this file to .env.local and configure your project credentials
# Note: PromptKeeper works 100% locally offline even without Supabase!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional GitHub Personal Access Token (5,000 requests/hour for Repository Hub)
VITE_GITHUB_TOKEN=
